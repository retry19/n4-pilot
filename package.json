{
  "name": "n4-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "N4 Pilot — exam-readiness OS untuk JLPT N4. PWA mobile-first, Bahasa Indonesia.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "smoke": "node scripts/smoke.mjs",
    "smoke:routes": "node scripts/route-smoke.mjs",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "lint:copy": "node scripts/copy-lint.mjs --write",
    "inspect": "node scripts/inspect.mjs",
    "scenario": "node scripts/scenario.mjs",
    "content:report": "node scripts/content-report.mjs",
    "report": "node scripts/report.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "docs:sync": "node scripts/docs.mjs --sync",
    "verify": "node scripts/copy-lint.mjs --write && node scripts/test.mjs && tsc -p tsconfig.json --noEmit && node scripts/build.mjs && node scripts/smoke.mjs && node scripts/route-smoke.mjs && node scripts/a11y-audit.mjs && node scripts/report.mjs && node scripts/docs.mjs --check",
    "icons": "python scripts/make-icons.py"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.3",
    "rollup": "^4.50.0",
    "typescript": "^5.9.0"
  }
}
